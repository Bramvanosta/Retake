{
  "name": "retake",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run",
    "test:pg": "node scripts/test-pg.mjs",
    "test:slow": "RETAKE_TEST_SLOW=1 vitest run packages/cli/test/catalogue-acceptance.test.ts packages/editor/test/loop-real.test.ts packages/mcp/test/fixture-acceptance.test.ts packages/mcp/test/authoring-acceptance.test.ts packages/mcp/test/record-acceptance.test.ts packages/mcp/test/theme-acceptance.test.ts packages/mcp/test/phase3-acceptance.test.ts packages/mcp/test/plugin.test.ts packages/ui/test/scenario-run-acceptance.test.ts packages/ui/test/studio-e2e-themes-acceptance.test.ts packages/ui/test/studio-e2e-record-acceptance.test.ts",
    "retake": "node packages/cli/dist/bin.js",
    "fixture": "node fixtures/wholesale/server.mjs",
    "req": "node scripts/requirements.mjs",
    "desktop:dev": "node apps/desktop/scripts/desktop.mjs dev",
    "desktop:build": "node apps/desktop/scripts/desktop.mjs build",
    "desktop:test": "node apps/desktop/scripts/desktop.mjs test",
    "desktop:clean": "node apps/desktop/scripts/desktop.mjs clean",
    "desktop:bundle": "node apps/desktop/scripts/bundle.mjs build",
    "desktop:release": "node apps/desktop/scripts/bundle.mjs build --release"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@remotion/compositor-linux-x64-gnu"
    ],
    "overrides": {
      "@napi-rs/canvas": "-"
    }
  }
}
