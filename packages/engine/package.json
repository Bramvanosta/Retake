    "@retake/core": "workspace:*",
    "@retake/editor": "workspace:*",
    "@retake/hooks": "workspace:*",
    "@retake/review": "workspace:*",
    "@retake/runner-web": "workspace:*",
    "@retake/sandbox": "workspace:*",
    "zod": "^4.1.0"
  }
}
