{
  "name": "@retake/engine",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalogue": {
      "source": "./src/catalogue.ts",
      "types": "./dist/catalogue.d.ts",
      "default": "./dist/catalogue.js"
    },
    "./shell": {
      "source": "./src/shell-entry.ts",
      "types": "./dist/shell-entry.d.ts",
      "default": "./dist/shell-entry.js"
    },
    "./contract": {
      "source": "./src/contract.ts",
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./doctor": {
      "source": "./src/doctor-entry.ts",
      "types": "./dist/doctor-entry.d.ts",
      "default": "./dist/doctor-entry.js"
    },
    "./integrations": {
      "source": "./src/integrations.ts",
      "types": "./dist/integrations.d.ts",
      "default": "./dist/integrations.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@retake/components": "workspace:*",
    "@retake/core": "workspace:*",
    "@retake/editor": "workspace:*",
    "@retake/hooks": "workspace:*",
    "@retake/review": "workspace:*",
    "@retake/runner-web": "workspace:*",
    "@retake/sandbox": "workspace:*",
    "zod": "^4.1.0"
  }
}
