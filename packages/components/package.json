{
  "name": "@retake/components",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit": {
      "source": "./src/kit/index.ts",
      "types": "./dist/kit/index.d.ts",
      "default": "./dist/kit/index.js"
    },
    "./geometry": {
      "source": "./src/geometry-entry.ts",
      "types": "./dist/geometry-entry.d.ts",
      "default": "./dist/geometry-entry.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "scaffolds",
    "library",
    "preview"
  ],
  "scripts": {
    "build": "tsc -b",
    "gen:schema": "tsx scripts/gen-schema.ts"
  },
  "dependencies": {
    "@retake/core": "workspace:*",
    "@remotion/lottie": "4.0.534",
    "esbuild": "0.28.1",
    "lottie-web": "5.13.0",
    "react": "19.1.1",
    "remotion": "4.0.534",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "qrcode": "1.5.4",
    "react-dom": "19.1.1"
  }
}
