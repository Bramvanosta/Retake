  "look": {
   "css": "\n    :host{all:initial}\n    .c{position:absolute;left:0;top:0;display:none;will-change:transform}\n    .c.on{display:block}\n    .s{position:absolute;left:0;top:0;transform-origin:0 0;transition:transform 90ms ease-out}\n    .s.p{transform:scale(.9)}\n    .c svg{position:absolute;display:none;overflow:visible;filter:drop-shadow(0 2px 3px rgba(0,0,0,.35))}\n    .c[data-k=arrow] svg.arrow,.c[data-k=hand] svg.hand,.c[data-k=ibeam] svg.ibeam{display:block}\n    .dbg{position:absolute;left:-3px;top:-3px;width:6px;height:6px;background:#FF00FF}\n    .rp{position:absolute;left:0;top:0;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;\n        background:rgba(1,2,3,.4);pointer-events:none;\n        box-shadow:0 0 0 1.1px rgba(255,255,255,.95),0 0 0 2px rgba(17,17,17,.3);\n        animation:dsr-t 500ms cubic-bezier(.2,.7,.2,1) forwards,dsr-o 550ms ease-out forwards}\n    @keyframes dsr-t{from{transform:var(--p) scale(.4)}to{transform:var(--p) scale(5.5)}}\n    @keyframes dsr-o{from{opacity:1}to{opacity:0}}\n    .g{position:absolute;left:0;top:0;display:flex;align-items:center;gap:12px;padding:10px 16px 10px 10px;\n       background:#fff;border:1px solid rgba(31,20,19,.12);border-radius:12px;\n       box-shadow:0 16px 36px rgba(31,20,19,.22),0 2px 6px rgba(31,20,19,.08);\n       font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",Inter,Roboto,\"Helvetica Neue\",Arial,sans-serif;\n       opacity:0;transition:opacity .25s ease-out;white-space:nowrap;transform-origin:30px 22px}\n    .g.on{opacity:1}\n    .g .b{position:relative;width:36px;height:44px;flex:none}\n    .g .b svg{display:block}\n    .g .b span{position:absolute;left:0;right:0;bottom:6px;text-align:center;color:#fff;font-size:10px;font-weight:700;letter-spacing:.02em}\n    .g .n{font-size:15px;font-weight:600;color:#1f1413;line-height:1.25}\n    .g .d{font-size:12px;color:#6b605d;line-height:1.3;margin-top:2px}\n  ",
   "html": "<div class=\"rps\"></div><div class=\"g\"></div><div class=\"c\" data-k=\"arrow\"><div class=\"s\"><svg class=\"arrow\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" style=\"left:-5px;top:-2.5px\"><path d=\"M4 2 L4 19 L8.5 14.8 L11.6 21.6 L14.6 20.3 L11.6 13.6 L17.8 13.6 Z\" fill=\"#fff\" stroke=\"#111\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg><svg class=\"hand\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" style=\"left:-12px;top:-2.375px\"><line x1=\"9.6\" y1=\"3\" x2=\"9.6\" y2=\"13\" stroke=\"#111\" stroke-width=\"5\" stroke-linecap=\"round\"/><line x1=\"12.35\" y1=\"9.5\" x2=\"12.35\" y2=\"14\" stroke=\"#111\" stroke-width=\"4.9\" stroke-linecap=\"round\"/><line x1=\"15\" y1=\"10.4\" x2=\"15\" y2=\"14.5\" stroke=\"#111\" stroke-width=\"4.800000000000001\" stroke-linecap=\"round\"/><line x1=\"17.5\" y1=\"11.6\" x2=\"17.5\" y2=\"15\" stroke=\"#111\" stroke-width=\"4.6\" stroke-linecap=\"round\"/><line x1=\"8.7\" y1=\"17.4\" x2=\"5.7\" y2=\"14.2\" stroke=\"#111\" stroke-width=\"4.800000000000001\" stroke-linecap=\"round\"/><path d=\"M8.25 12.2 H18.7 V16.6 C18.7 19.7 16.7 21.7 13.7 21.7 H12.6 C10.9 21.7 9.8 21 8.9 19.8 L8.25 18.9 Z\" fill=\"#111\" stroke=\"#111\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/><line x1=\"9.6\" y1=\"3\" x2=\"9.6\" y2=\"13\" stroke=\"#fff\" stroke-width=\"2.8\" stroke-linecap=\"round\"/><line x1=\"12.35\" y1=\"9.5\" x2=\"12.35\" y2=\"14\" stroke=\"#fff\" stroke-width=\"2.7\" stroke-linecap=\"round\"/><line x1=\"15\" y1=\"10.4\" x2=\"15\" y2=\"14.5\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\"/><line x1=\"17.5\" y1=\"11.6\" x2=\"17.5\" y2=\"15\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\"/><line x1=\"8.7\" y1=\"17.4\" x2=\"5.7\" y2=\"14.2\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\"/><path d=\"M8.25 12.2 H18.7 V16.6 C18.7 19.7 16.7 21.7 13.7 21.7 H12.6 C10.9 21.7 9.8 21 8.9 19.8 L8.25 18.9 Z\" fill=\"#fff\"/><path d=\"M11 11.9 V13.8 M13.68 12.3 V14.