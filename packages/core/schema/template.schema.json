{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "colors": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "minLength": 1,
          "description": "Accent colour (CSS)."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Main text colour."
        },
        "muted": {
          "type": "string",
          "minLength": 1,
          "description": "Secondary text colour."
        },
        "paper": {
          "type": "string",
          "minLength": 1,
          "description": "Background / paper colour."
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Brand colours (extra keys allowed)."
    },
    "fonts": {
      "type": "object",
      "properties": {
        "display": {
          "type": "string",
          "pattern": "\\.(ttf|otf|woff2?)$",
          "description": "Display font file."
        },
        "body": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\.(ttf|otf|woff2?)$"
          },
          "description": "Body font files (regular, semibold, bold…)."
        }
      },
      "additionalProperties": false,
      "description": "Font files relative to the template dir."
    },
    "logo": {
      "type": "string",
      "pattern": "\\.(svg|png|jpe?g|webp)$",
      "description": "Logo file relative to the template dir."
    },
    "wordmark": {
      "type": "string",
      "pattern": "\\.(svg|png|jpe?g|webp)$",
      "description": "Wordmark image (outro)."
    },
    "background": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "solid",
            "radial",
            "linear"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "raw",
            "card",
            "browser",
            "laptop",
            "phone",
            "tablet"
          ],
          "description": "How the capture is framed: raw, card, browser chrome, laptop, phone or tablet mockup."
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Frame width in px at 1920×1080."
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "shadow": {
          "type": "string",
          "enum": [
            "none",
            "soft",
            "strong"
          ]
        }
      },
      "additionalProperties": false
    },
    "captions": {
      "type": "object",
      "properties": {
        "position": {
          "type": "string",
          "enum": [
            "below",
            "above",
            "overlay",
            "none"
          ]
        },
        "kicker": {
          "type": "object",
          "properties": {
            "font": {
              "type": "string",
              "enum": [
                "display",
                "body"
              ]
            },
            "weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Font size in px at 1920×1080."
            },
            "uppercase": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "minLength": 1,
              "description": "Colour key (accent/text/muted/paper) or CSS colour."
            },
            "letter_spacing": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "line": {
          "type": "object",
          "properties": {
            "font": {
              "type": "string",
              "enum": [
                "display",
                "body"
              ]
            },
            "weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Font size in px at 1920×1080."
            },
            "uppercase": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "minLength": 1,
              "description": "Colour key (accent/text/muted/paper) or CSS colour."
            },
            "letter_spacing": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "intro": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layout": {
          "type": "string",
          "enum": [
            "logo-kicker-title",
            "kicker-title",
            "logo-only"
          ]
        }
      },
      "additionalProperties": false
    },
    "outro": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layout": {
          "type": "string",
          "enum": [
            "logo-wordmark-tagline-url",
            "logo-tagline",
            "logo-only"
          ]
        },
        "url": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "interstitial": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "dark-clock",
            "paper",
            "dark"
          ]
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "object",
      "properties": {
        "between_scenes": {
          "type": "string",
          "enum": [
            "crossfade",
            "cut",
            "fade-black"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "arrow-dark",
            "arrow-light",
            "debug"
          ]
        },
        "ripple_color": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "default_zoom": {
          "anyOf": [
            {
              "type": "string",
              "const": "none"
            },
            {
              "type": "number",
              "minimum": 1,
              "maximum": 3
            }
          ]
        },
        "max_zoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "zoom_ease": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "description": "cubic-bezier [x1, y1, x2, y2]."
        }
      },
      "additionalProperties": false
    },
    "style_bias": {
      "type": "string",
      "enum": [
        "real",
        "balanced",
        "motion"
      ],
      "description": "How much motion design is added: real | balanced | motion."
    },
    "brandmark": {
      "type": "object",
      "properties": {
        "position": {
          "type": "string",
          "enum": [
            "bottom-right",
            "bottom-left",
            "top-right",
            "none"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Brand name (wordmark drawn as text when there is no wordmark image)."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Brand URL as shown, e.g. example.com (outro url when the scenario/template sets none)."
        }
      },
      "additionalProperties": false,
      "description": "Brand name and URL."
    },
    "components": {
      "type": "object",
      "properties": {
        "intro": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Intro card, e.g. studio/intro-stack or studio/intro-minimal. An id \"namespace/name\" or {id, params}."
        },
        "outro": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Outro card, e.g. studio/outro-stack or studio/outro-minimal. An id \"namespace/name\" or {id, params}."
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Full-screen card of scenario `card:` entries, e.g. studio/card-title. An id \"namespace/name\" or {id, params}."
        },
        "interstitial": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "\"Time passes\" card, e.g. studio/interstitial-clock or studio/interstitial-plain. An id \"namespace/name\" or {id, params}."
        },
        "caption": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Caption renderer, e.g. studio/caption-below or studio/caption-overlay; null = no captions. An id \"namespace/name\" or {id, params}."
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Screen layout around the capture, e.g. studio/layout-card, studio/layout-browser, studio/layout-raw. An id \"namespace/name\" or {id, params}."
        },
        "overlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Default overlay of step `overlay:` modifiers, e.g. studio/overlay-callout. An id \"namespace/name\" or {id, params}."
        },
        "transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Transition between scenes, e.g. studio/transition-crossfade; null = cut. An id \"namespace/name\" or {id, params}."
        }
      },
      "additionalProperties": false,
      "description": "Default component per kind (id or {id, params}; null = none). A kind left out is mapped from the legacy fields (frame.style, intro.layout, outro.layout, interstitial.style, captions.position, transitions.between_scenes)."
    }
  },
  "additionalProperties": false,
  "title": "Demo Studio template",
  "description": "Brand & motion style (templates/<name>/template.yaml), merged over the default template.",
  "$defs": {
    "ComponentRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$",
              "description": "Component id \"namespace/name\"."
            },
            "params": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "Component params (see the component's params schema; unset params take its defaults)."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A component id \"namespace/name\" (e.g. studio/intro-stack), or {id, params}."
    }
  }
}
