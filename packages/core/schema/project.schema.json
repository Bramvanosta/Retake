{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the product / project."
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "env name → page key → base URL, e.g. {staging: {console: https://…, shop: https://…}}."
    },
    "default_env": {
      "type": "string",
      "minLength": 1,
      "description": "Environment used when a scenario does not say (default: the first one)."
    },
    "auth": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthConfig"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/AuthConfig"
          }
        }
      ],
      "description": "Global auth, or per environment name. Never passwords."
    },
    "capture": {
      "$ref": "#/$defs/CaptureOverrides"
    },
    "frame": {
      "description": "Default frame of every scenario (default card): raw, card, browser, laptop, phone, tablet or a layout component id \"namespace/name\".",
      "$ref": "#/$defs/Frame"
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "description": "Template name (the workspace templates/<name>, else a starter template: default, editorial, motion) or a path relative to the project dir."
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "allow_hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Extra hosts hooks may target (environment hosts and localhost are always allowed)."
    },
    "databases": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Connection URL; use {{env:VAR}} / {{keychain:service/account}} for credentials."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "pacing": {
      "$ref": "#/$defs/PacingOverrides"
    },
    "browser": {
      "$ref": "#/$defs/BrowserConfig"
    },
    "reset": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HookStep"
      },
      "description": "Hooks run by env_reset."
    },
    "vars": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Variables shared by every scenario ({{vars.x}})."
    },
    "mailbox": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "mailpit",
            "http"
          ],
          "description": "mailpit: the Mailpit API; http: the generic JSON shape (see the README)."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Base URL of the mailbox API, e.g. http://localhost:8025 (its host must be allowed)."
        },
        "poll_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000,
          "description": "Polling interval in ms (default 500)."
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra request headers, e.g. an API token ({{env:VAR}} references are expanded)."
        }
      },
      "required": [
        "provider",
        "url"
      ],
      "additionalProperties": false,
      "description": "Test mailbox read by wait_for_email (Mailpit or a generic HTTP JSON API)."
    },
    "raw": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "mp4",
            "prores"
          ],
          "description": "Clip codec: mp4 (H.264 high, CRF 14) or prores (ProRes 422 HQ .mov). Default mp4."
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 60
            }
          ],
          "description": "Clip frame rate (default 30)."
        },
        "cursor": {
          "type": "string",
          "enum": [
            "baked",
            "none",
            "layer"
          ],
          "description": "baked (as captured), none (captured without the cursor; cursor data only) or layer (a transparent cursor video per clip). Default baked."
        },
        "layer": {
          "type": "string",
          "enum": [
            "prores",
            "webm"
          ],
          "description": "Cursor layer codec: prores (ProRes 4444) or webm (VP9 alpha). Default prores."
        },
        "selects": {
          "type": "boolean",
          "description": "Also write one continuous selects file of the clips (default false)."
        },
        "cuts": {
          "type": "boolean",
          "description": "Cut the loading inside scenes (default true)."
        }
      },
      "additionalProperties": false,
      "description": "Defaults of the raw capture export for editors (studio export-capture, studio run --raw)."
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "title": "Demo Studio project",
  "description": "projects/<slug>/project.yaml",
  "$defs": {
    "AuthConfig": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "Persistent, pre-authenticated Chromium profile directory (~ expanded)."
        },
        "storage_state": {
          "type": "string",
          "minLength": 1,
          "description": "Playwright storageState JSON (alternative to profile)."
        }
      },
      "additionalProperties": false,
      "description": "Never a password: a pre-authenticated profile or storage state."
    },
    "CaptureOverrides": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 200,
          "maximum": 7680,
          "description": "Viewport width in CSS px."
        },
        "height": {
          "type": "integer",
          "minimum": 200,
          "maximum": 4320,
          "description": "Viewport height in CSS px."
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4,
          "description": "deviceScaleFactor: 1, or 2 for 4K from a 1920×1080 viewport."
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "description": "Output frame rate of capture.mp4."
        },
        "format": {
          "type": "string",
          "enum": [
            "jpeg",
            "png"
          ],
          "description": "Screencast frame format."
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "JPEG quality (1-100)."
        },
        "keep_frames": {
          "type": "boolean",
          "description": "Keep runs/<id>/frames after encoding."
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51,
          "description": "libx264 CRF of capture.mp4."
        }
      },
      "additionalProperties": false,
      "description": "Capture settings (merged over the defaults: 1920×1080, scale 1, 30 fps, jpeg 100, crf 16)."
    },
    "Frame": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "raw",
            "card",
            "browser",
            "laptop",
            "phone",
            "tablet"
          ],
          "description": "How the capture is framed: raw, card, browser chrome, laptop, phone or tablet mockup."
        },
        {
          "type": "string",
          "enum": [
            "split",
            "pip"
          ],
          "description": "Layout of a multi-page scene: split (side by side, stacked in vertical) or pip (picture in picture)."
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$",
          "description": "A layout component id \"namespace/name\", e.g. studio/layout-card or a workspace layout."
        }
      ],
      "description": "How the capture is framed: raw, card, browser, laptop, phone or tablet (built-in layouts studio/layout-<style>), split or pip for a multi-page scene (studio/layout-split, studio/layout-pip), or a layout component id \"namespace/name\"."
    },
    "PacingOverrides": {
      "type": "object",
      "properties": {
        "scene_start_still": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds still at scene start (1.5–2)."
        },
        "move_base_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Cursor travel: ms = clamp(move_base_ms + distance·move_ms_per_px, move_min_ms, move_max_ms)."
        },
        "move_ms_per_px": {
          "type": "number",
          "minimum": 0,
          "description": "See move_base_ms (field notes: 0.9 ms per px)."
        },
        "move_min_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Shortest ordinary move (450)."
        },
        "move_max_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Longest move (1100)."
        },
        "nudge_px": {
          "type": "number",
          "minimum": 0,
          "description": "Moves shorter than this (px) are nudges: repeated clicks on almost the same spot."
        },
        "nudge_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Travel time of a nudge of nudge_px (shorter nudges: down to 60 % of it; zero-length moves: 0)."
        },
        "nudge_hover_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Hover pause before pressing after a nudge."
        },
        "hover_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Hover pause before pressing (150–250)."
        },
        "press_ms": {
          "type": "number",
          "minimum": 0,
          "description": "mousedown → mouseup."
        },
        "after_click_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Pause after an ordinary click."
        },
        "after_popup_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Pause after a click that opened a popup (600–1000)."
        },
        "after_navigation_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Minimum time after a click that navigated or changed the URL before the next step (1.5–2.8 s)."
        },
        "popup_fallback_ms": {
          "type": "number",
          "minimum": 0,
          "description": "How long a click gets to show that an expected popup opened (aria-expanded / new popup, polled) before the next click strategy."
        },
        "popup_timeout_ms": {
          "type": "number",
          "minimum": 0,
          "description": "How long the last click strategy waits for an expected popup before reporting it missing."
        },
        "type_cps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Typing speed, characters per second (9–24)."
        },
        "page_switch_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Multi-page scenes: pause before a step that acts on another page than the previous step (its cursor then glides from where it rests)."
        },
        "scroll_duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Smooth scroll duration in seconds (1.5–2)."
        },
        "scroll_offset": {
          "type": "number",
          "description": "Default scroll offset with a target (−140 ⇒ the target ends 140 px below the top)."
        },
        "jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "description": "Deterministic ±fraction jitter applied to durations (0 = none)."
        },
        "settle_ms": {
          "type": "number",
          "minimum": 0,
          "description": "After navigation: wait for network idle up to this many ms."
        }
      },
      "additionalProperties": false,
      "description": "Deterministic pacing overrides (merged over the field-tested defaults)."
    },
    "BrowserConfig": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "enum": [
            "chromium",
            "headless-shell",
            "chrome"
          ],
          "description": "'chromium' = new headless (default)."
        },
        "headless": {
          "type": "boolean"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "color_scheme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        }
      },
      "additionalProperties": false
    },
    "HookStep": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "http": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "HEAD"
                  ],
                  "description": "Default GET."
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Request URL; templated ({{page}}, {{vars.x}}, {{env:VAR}}…)."
                },
                "headers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "json": {
                  "description": "JSON body."
                },
                "body": {
                  "type": "string",
                  "description": "Raw body."
                },
                "expect": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 599
                      }
                    }
                  ],
                  "description": "Expected status code(s). Default: any 2xx."
                },
                "save_as": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
                  "description": "Store the response as {{hooks.<save_as>.status|body|json.<path>}}."
                },
                "rollback": {
                  "type": "object",
                  "properties": {
                    "method": {
                      "type": "string",
                      "enum": [
                        "GET",
                        "POST",
                        "PUT",
                        "PATCH",
                        "DELETE",
                        "HEAD"
                      ],
                      "description": "Default GET."
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Request URL; templated ({{page}}, {{vars.x}}, {{env:VAR}}…)."
                    },
                    "headers": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "json": {
                      "description": "JSON body."
                    },
                    "body": {
                      "type": "string",
                      "description": "Raw body."
                    },
                    "expect": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 599
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 100,
                            "maximum": 599
                          }
                        }
                      ],
                      "description": "Expected status code(s). Default: any 2xx."
                    }
                  },
                  "required": [
                    "url"
                  ],
                  "additionalProperties": false,
                  "description": "Request that undoes this one (templated after the request: {{response.json.id}})."
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Name shown in logs and journals."
            },
            "confirm": {
              "type": "boolean",
              "description": "Required (true) for destructive hooks."
            },
            "destructive": {
              "type": "boolean",
              "description": "Declare the hook destructive explicitly (also auto-detected)."
            },
            "optional": {
              "type": "boolean",
              "description": "Continue even if this hook fails."
            }
          },
          "required": [
            "http"
          ],
          "additionalProperties": false,
          "title": "http",
          "description": "HTTP request (fetch); response saved for templating; optional rollback request."
        },
        {
          "type": "object",
          "properties": {
            "sql": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "A .sql file relative to the project dir, or an inline query."
                },
                {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "description": "SQL file relative to the project dir."
                    },
                    "query": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Inline SQL."
                    },
                    "db": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Database key from project.databases (default: the first one)."
                    },
                    "rollback": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "properties": {
                            "file": {
                              "type": "string",
                              "minLength": 1
                            },
                            "query": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      ],
                      "description": "SQL that undoes this hook: a *.sql file or inline SQL."
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Name shown in logs and journals."
            },
            "confirm": {
              "type": "boolean",
              "description": "Required (true) for destructive hooks."
            },
            "destructive": {
              "type": "boolean",
              "description": "Declare the hook destructive explicitly (also auto-detected)."
            },
            "optional": {
              "type": "boolean",
              "description": "Continue even if this hook fails."
            }
          },
          "required": [
            "sql"
          ],
          "additionalProperties": false,
          "title": "sql",
          "description": "SQL file or inline query run in a transaction (project.databases)."
        },
        {
          "type": "object",
          "properties": {
            "shell": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Command run with sh -c in the project dir."
                },
                {
                  "type": "object",
                  "properties": {
                    "run": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cwd": {
                      "type": "string",
                      "minLength": 1
                    },
                    "env": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "rollback": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Command that undoes this one."
                    },
                    "timeout": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "run"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Name shown in logs and journals."
            },
            "confirm": {
              "type": "boolean",
              "description": "Required (true) for destructive hooks."
            },
            "destructive": {
              "type": "boolean",
              "description": "Declare the hook destructive explicitly (also auto-detected)."
            },
            "optional": {
              "type": "boolean",
              "description": "Continue even if this hook fails."
            }
          },
          "required": [
            "shell"
          ],
          "additionalProperties": false,
          "title": "shell",
          "description": "Shell command (sh -c) in the project dir."
        },
        {
          "type": "object",
          "properties": {
            "js": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Inline JS evaluated in a page (function body)."
                },
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Inline JS (function body; may return / await)."
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "description": "JS file relative to the project dir."
                    },
                    "page": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
                      "description": "Environment page key whose page runs it (default: the first page)."
                    },
                    "rollback": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Name shown in logs and journals."
            },
            "confirm": {
              "type": "boolean",
              "description": "Required (true) for destructive hooks."
            },
            "destructive": {
              "type": "boolean",
              "description": "Declare the hook destructive explicitly (also auto-detected)."
            },
            "optional": {
              "type": "boolean",
              "description": "Continue even if this hook fails."
            }
          },
          "required": [
            "js"
          ],
          "additionalProperties": false,
          "title": "js",
          "description": "JavaScript evaluated in a browser page (through the runner)."
        }
      ],
      "description": "Exactly one of http, sql, shell, js, plus name / confirm / destructive / optional."
    }
  }
}
